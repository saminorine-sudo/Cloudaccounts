# CloudAccounts — environment variables
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# NEVER commit real keys. Only variables prefixed NEXT_PUBLIC_ reach the
# browser — everything else stays server-side, so no secret below is ever
# exposed in client code.
#
# The site runs with none of these set. Missing integrations degrade
# gracefully: emails are logged rather than sent, and webhooks are skipped.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin. Used for canonical URLs, Open Graph tags, the sitemap and
# robots.txt. A trailing slash is fine — it is stripped.
#
# Leave it BLANK rather than half-set: an empty value falls back to the
# platform's own domain (Vercel supplies one automatically) and then to a
# placeholder. Only a value that actually parses as an http(s) URL is used.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
# Delivers enquiry notifications and acknowledgements. Without a key, messages
# are logged to the server console instead of being sent.
RESEND_API_KEY=
# Must be an address on a domain you have verified with the email provider.
EMAIL_FROM=no-reply@example.com
# Internal inbox that receives new enquiry, contact and booking notifications.
ADMIN_NOTIFICATION_EMAIL=enquiries@example.com

# ---------------------------------------------------------------------------
# Automation (n8n)
# ---------------------------------------------------------------------------
# Receives lead.created, contact.created and appointment.created events.
N8N_WEBHOOK_URL=
# Sent as the x-cloudaccounts-signature header so the workflow can verify the
# request came from this application. Use a long random string.
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Database (Supabase)
# ---------------------------------------------------------------------------
# Set these and the site reads content from the database and stores
# submissions durably. Leave them blank and it falls back to the content
# modules in src/content with submissions held in memory.
#
# See docs/SUPABASE-SETUP.md for migrations, seeding and the security tests.
#
# The anon key is safe to expose ONLY because Row Level Security is enforced
# on every table. The service role key bypasses RLS entirely — it must never
# be prefixed NEXT_PUBLIC_ and must never be imported into a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A production server refuses to start without the three variables above, so
# a deployment cannot silently hold enquiries in memory and lose them on
# restart. Set this to deploy a content-only preview on purpose.
# ALLOW_UNCONFIGURED_PRODUCTION=true

# ---------------------------------------------------------------------------
# Admin area
# ---------------------------------------------------------------------------
# Staff sign in at /admin/login with email and password. An unconfigured
# production server refuses to open the admin area at all.
#
# This flag opens it against the local in-memory store so the CRM screens can
# be worked on. It requires a non-production build as well, so setting it on a
# deployed site does nothing.
# ADMIN_DEV_PREVIEW=true

# ---------------------------------------------------------------------------
# Analytics — not yet wired up
# ---------------------------------------------------------------------------
# Nothing loads until the visitor gives analytics consent. Never send
# financial figures or personal data to an analytics provider.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Booking provider — not yet wired up
# ---------------------------------------------------------------------------
# Availability currently comes from the consultation type configuration in
# src/content/guides.ts. Connecting a provider replaces the availability
# source behind src/lib/booking/availability.ts.
BOOKING_PROVIDER_API_KEY=
